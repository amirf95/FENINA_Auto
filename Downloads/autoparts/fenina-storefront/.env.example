# Copy this file to .env.local if you need to point the storefront at a
# non-default backend (e.g. a staging or production API).
#
# The chatbot no longer talks to Anthropic directly from the browser — it
# calls the Django backend's /api/chatbot/ proxy, which holds the real
# Anthropic key server-side (see admin/fenina-api/fenina-api/.env.example).
VITE_API_BASE_URL=http://localhost:8000/api
