            },
            {
              "fieldLabel": "Catégorie",
              "fieldType": "text",
              "defaultValue": "={{ $json.category }}"
            },
            {
              "fieldLabel": "Référence OEM",
              "fieldType": "text",
              "defaultValue": "={{ $json.oem }}"
            },
            {
              "fieldLabel": "Prix de vente",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "Prix achat (HT)",
              "fieldType": "number",
              "defaultValue": "={{ $json.priceht }}"
            },
            {
              "fieldLabel": "Quantité initiale",
              "fieldType": "number",
              "defaultValue": "0",
              "requiredField": true
            },
            {
              "fieldLabel": "Seuil alerte",
              "fieldType": "number",
              "defaultValue": "5"
            },
            {
              "fieldLabel": "Emplacement",
              "fieldType": "text",
              "defaultValue": "={{ $json.location }}"
            },
            {
              "fieldLabel": "barcode_value",
              "fieldType": "hiddenField",
              "fieldValue": "={{ $json.barcode }}"
            }
          ]
        },
        "options": {}
      },
      "id": "f1a1b2c3-0000-4aaa-8001-000000000007",
      "name": "Compléter la pièce",
      "type": "n8n-nodes-base.form",
      "typeVersion": 1,
      "position": [1100, 300],
      "webhookId": "f1a1b2c3-0000-4aaa-8001-000000000008"
    },
    {
      "parameters": {
        "url": "={{ $('Config').item.json.apiBase }}/api/auth/login/",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"email\": \"{{ $('Config').item.json.email }}\",\n  \"password\": \"{{ $('Config').item.json.password }}\"\n}",
        "options": {}
      },
      "id": "f1a1b2c3-0000-4aaa-8001-000000000009",
      "name": "Connexion 2",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "url": "={{ $('Config').item.json.apiBase }}/api/parts/",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.access }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"sku\": \"{{ $('Compléter la pièce').item.json['SKU'] }}\",\n  \"name\": \"{{ $('Compléter la pièce').item.json['Désignation'] }}\",\n  \"oem\": \"{{ $('Compléter la pièce').item.json['Référence OEM'] }}\",\n  \"barcode\": \"{{ $('Compléter la pièce').item.json['barcode_value'] }}\",\n  \"qr_code\": null,\n  \"brand\": \"{{ $('Compléter la pièce').item.json['Marque'] }}\",\n  \"category\": \"{{ $('Compléter la pièce').item.json['Catégorie'] }}\",\n  \"specs\": {},\n  \"price\": \"{{ $('Compléter la pièce').item.json['Prix de vente'] }}\",\n  \"priceht\": \"{{ $('Compléter la pièce').item.json['Prix achat (HT)'] }}\",\n  \"quantity\": {{ $('Compléter la pièce').item.json['Quantité initiale'] }},\n  \"reorder_level\": {{ $('Compléter la pièce').item.json['Seuil alerte'] }},\n  \"location\": \"{{ $('Compléter la pièce').item.json['Emplacement'] }}\"\n}",
        "options": {}
      },
