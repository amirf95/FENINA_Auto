# Copy this file to ".env" and fill in real values.

# Generate a new secret key for production (keep it private):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-insecure-change-me-in-production

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL empty to use SQLite (easy local dev).
# To use PostgreSQL, set it like below:
# DATABASE_URL=postgres://fenina_user:yourpassword@localhost:5432/fenina_db
DATABASE_URL=

# Frontend dev servers allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# Powers the storefront chatbot proxy at /api/chatbot/ — kept server-side only.
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — leave empty to use UPCitemdb's free trial tier for the barcode
# autofill on the add-part form (100 lookups/day, no signup required).
# Set this to switch to a paid UPCitemdb plan instead.
UPCITEMDB_API_KEY=
